---
import { getConfig } from '@lib/config';
import { getBio } from '@lib/content';
import { renderParagraphs } from '@lib/markdown';
import { withBase } from '@lib/utils';

const config = getConfig();
const bio = getBio();

// Order and labels of the small links under the intro.
const linkLabels: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  twitter: 'Twitter',
  google_scholar: 'Scholar',
  cv: 'CV',
  email: 'Email',
};
const links = Object.entries(config.social)
  .filter(([, url]) => url && url.length > 0)
  .map(([key, url]) => ({
    key,
    label: linkLabels[key] ?? key.replace(/_/g, ' '),
    href: key === 'email' ? `mailto:${url}` : withBase(url),
    external: key !== 'email',
  }));
---

<section class="flex gap-6 sm:gap-8 items-start">
  <img
    src={withBase(config.profile.avatar)}
    alt={config.profile.name}
    width="186"
    height="186"
    class="portrait shrink-0 w-[7rem] h-[7rem] min-[420px]:w-[9rem] min-[420px]:h-[9rem] sm:w-[11.6rem] sm:h-[11.6rem] object-cover"
  />

  <div class="min-w-0">
    <h1 class="name">
      {config.profile.name}
      {config.profile.name_cn && (
        <span class="name-cn" aria-label="Chinese name">{config.profile.name_cn}</span>
      )}
    </h1>

    <p class="affil mt-2 leading-snug">
      {config.profile.position}<br />
      {config.profile.affiliation}, {config.profile.university}
    </p>

    <ul class="links mt-3 flex flex-wrap items-baseline gap-x-5 gap-y-1 list-none p-0 m-0">
      {links.map(l => (
        <li>
          <a
            href={l.href}
            class="tiny-link"
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'noopener noreferrer' : undefined}
          >{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<div class="mt-5 bio" set:html={renderParagraphs(bio)} />

<p class="mt-3 interests">{config.profile.interests}</p>

<style>
  .portrait {
    border: 1px solid var(--color-rule);
    padding: 3px;
    background: var(--color-card-bg);
  }
  .name {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 400;
    letter-spacing: 0.005em;
    line-height: 1.2;
    color: var(--color-text);
  }
  .name-cn {
    font-family: 'Noto Serif SC', var(--font-serif), serif;
    font-size: 1.25rem;
    color: var(--color-muted);
    margin-left: 0.5rem;
    letter-spacing: 0.08em;
    vertical-align: 0.08em;
  }
  .bio :global(p) { margin-bottom: 0.7rem; }
  .bio :global(p:last-child) { margin-bottom: 0; }
  .bio :global(ul) {
    list-style: disc;
    margin: 0 0 0.7rem;
    padding-left: 1.35rem;
  }
  .bio :global(ul:last-child) { margin-bottom: 0; }
  .bio :global(li) { margin-bottom: 0.2rem; }
  .interests {
    font-style: italic;
    color: var(--color-text-secondary);
    border-left: 1px solid var(--color-rule);
    padding-left: 0.85rem;
  }
  /* Affiliation and links scale up with the portrait, but stay below the
     body text in weight so the intro doesn't read as a hero. */
  .affil {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
  }
  .links :global(.tiny-link) { font-size: 0.9375rem; }

  @media (max-width: 520px) {
    .name { font-size: 1.6rem; overflow-wrap: anywhere; }
    .name-cn { font-size: 1rem; }
    .affil { font-size: 0.9375rem; }
  }
</style>
