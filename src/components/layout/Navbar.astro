---
import { getConfig, getNav } from '@lib/config';
import { withBase } from '@lib/utils';

const config = getConfig();
const nav = getNav();
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (p: string) => current === withBase(p).replace(/\/$/, '');
---

<!-- Navigation is deliberately near-invisible: a single quiet line. -->
<header class="w-full max-w-[46rem] mx-auto px-5 sm:px-6 pt-7 pb-8">
  <nav class="flex items-baseline gap-2 text-[0.8125rem]" aria-label="Primary">
    {nav.map((item, i) => (
      <>
        {i > 0 && <span aria-hidden="true" class="text-[var(--color-muted)]">·</span>}
        <a
          href={withBase(item.path)}
          aria-current={isActive(item.path) ? 'page' : undefined}
          class:list={[
            'nav-item',
            isActive(item.path) ? 'nav-item--active' : '',
          ]}
        >
          {item.label}
        </a>
      </>
    ))}
    <span class="ml-auto annotation hidden sm:inline">{config.profile.name_cn}</span>
  </nav>
</header>

<style>
  .nav-item {
    font-family: var(--font-sans);
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .nav-item:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-rule);
    text-decoration: none;
  }
  .nav-item--active {
    color: var(--color-text);
    border-bottom-color: var(--color-accent);
  }
</style>
