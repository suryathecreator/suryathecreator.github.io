---
import { getConfig } from '@lib/config';
import { withBase } from '@lib/utils';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import '@styles/global.css';
import '@styles/ink.css';

interface Props {
  title?: string;
  description?: string;
}

const config = getConfig();
const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${config.profile.name}` : config.site.title;
const pageDescription = description || config.site.description;
const canonicalURL = new URL(Astro.url.pathname, config.site.url).href;
---

<!DOCTYPE html>
<!-- Appearance is fixed: Classic, light. No runtime theme switching. -->
<html lang={config.site.language} data-theme="classic">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <meta name="description" content={pageDescription} />
  <meta name="author" content={config.profile.name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:site_name" content={config.profile.name} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
  <title>{pageTitle}</title>
  <slot name="head" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": config.profile.name,
    "jobTitle": config.profile.position,
    "affiliation": { "@type": "CollegeOrUniversity", "name": config.profile.university },
    "url": config.site.url + "/",
    "email": config.profile.email,
  })} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&family=Noto+Serif+SC:wght@400&display=swap"
    rel="stylesheet"
  />

  {config.analytics?.google_analytics && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${config.analytics.google_analytics}`}></script>
      <script is:inline define:vars={{ gaId: config.analytics.google_analytics }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )}

  <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
  <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon.png")} />
  <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
</head>
<body class="min-h-screen flex flex-col">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:px-3 focus:py-1.5 focus:bg-[var(--color-accent)] focus:text-white">Skip to content</a>
  <Navbar />
  <main id="main" class="flex-1 w-full max-w-[46rem] mx-auto px-5 sm:px-6 pb-10">
    <slot />
  </main>
  <Footer />
</body>
</html>
