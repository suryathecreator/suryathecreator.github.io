---
import { getConfig } from '@lib/config';

const config = getConfig();
const now = new Date();
const year = now.getFullYear();
const updated = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<footer class="w-full max-w-[46rem] mx-auto px-5 sm:px-6 pb-10">
  <div class="hairline"></div>
  <p class="mt-3 meta--tight meta flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <span>&copy; {year} {config.profile.name}</span>
    <span aria-hidden="true" class="text-[var(--color-muted)]">·</span>
    <span class="annotation">{config.profile.name_cn}</span>
    <span class="ml-auto annotation">Last updated {updated}</span>
  </p>
</footer>
