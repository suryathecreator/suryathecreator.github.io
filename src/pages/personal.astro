---
import BaseLayout from '@components/layout/BaseLayout.astro';
import SectionHead from '@components/ui/SectionHead.astro';
---

<BaseLayout title="Personal" description="Notes, reading, and things outside of research.">
  <section>
    <SectionHead title="Personal" title_cn="杂记" />
    <p class="lead">
      Placeholder. This quiet second page is for everything that isn't research —
      reading notes, photographs, music, whatever you like. Edit
      <code>src/pages/personal.astro</code>.
    </p>
  </section>

  <section class="section">
    <SectionHead title="Reading" title_cn="书" />
    <ul class="plain">
      <li>Placeholder title — <span class="meta">Author</span></li>
      <li>Placeholder title — <span class="meta">Author</span></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .section { margin-top: var(--section-gap); }
  .lead { color: var(--color-text); }
  code { font-size: 0.85em; color: var(--color-text-secondary); }
  .plain { list-style: none; margin: 0; padding: 0; }
  .plain li { padding: 0.3rem 0; font-size: 0.9375rem; }
  .plain li + li { border-top: 1px solid var(--color-rule); }
</style>
