---
import BaseLayout from '@components/layout/BaseLayout.astro';
import SectionHead from '@components/ui/SectionHead.astro';
import Intro from '@components/home/Intro.astro';
import NewsTimeline from '@components/home/NewsTimeline.astro';
import Publications from '@components/home/Publications.astro';
import AcademicTimeline from '@components/home/AcademicTimeline.astro';
import { getSection } from '@lib/config';
import { getNews, getPublications, getTimeline } from '@lib/content';

const news = getNews();
const pubs = getPublications();
const timeline = getTimeline();
---

<BaseLayout>
  <Intro />

  {news.length > 0 && (
    <section class="section animate-on-scroll">
      <SectionHead {...getSection('news')} />
      <NewsTimeline />
    </section>
  )}

  {pubs.length > 0 && (
    <section class="section animate-on-scroll">
      <SectionHead {...getSection('publications')} />
      <Publications />
    </section>
  )}

  {timeline.length > 0 && (
    <section class="section animate-on-scroll">
      <SectionHead {...getSection('timeline')} />
      <AcademicTimeline />
    </section>
  )}
</BaseLayout>

<style>
  .section { margin-top: var(--section-gap); }
</style>
