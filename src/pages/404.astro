---
import BaseLayout from '@components/layout/BaseLayout.astro';
import { withBase } from '@lib/utils';
---

<BaseLayout title="Page not found">
  <section class="pt-6">
    <p class="annotation">404</p>
    <h1 class="mt-2 title">Page not found</h1>
    <p class="mt-2 meta">This page doesn't exist, or it has moved.</p>
    <p class="mt-4"><a href={withBase('/')} class="tiny-link">Back to home</a></p>
  </section>
</BaseLayout>

<style>
  .title { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 400; }
</style>
